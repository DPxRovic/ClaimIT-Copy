# ==============================================================================
# ClaimIt Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# Do NOT store real production secrets or service account keys in version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dev Server & Local Runtime
# ------------------------------------------------------------------------------
PORT=3000

# Set to "true" to point Firebase Web SDK to local Emulator Suite ports
VITE_USE_FIREBASE_EMULATOR=true

# ------------------------------------------------------------------------------
# 2. Public Client Firebase Configuration (Vite Web SDK)
# ------------------------------------------------------------------------------
# In the Firebase security model, client-side Firebase keys identify the project.
# Access control and data protection are strictly enforced via Security Rules & Auth.
VITE_FIREBASE_API_KEY=demo-claimit-api-key
VITE_FIREBASE_AUTH_DOMAIN=claimit-campus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=claimit-campus
VITE_FIREBASE_STORAGE_BUCKET=claimit-campus.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 3. Privileged Server-Side Configuration (Cloud Functions & Admin SDK)
# ------------------------------------------------------------------------------
# When running locally with Firebase Emulators, the Admin SDK automatically uses
# simulated credentials. In production Cloud Functions, default service credentials
# are automatically assigned by Google Cloud IAM.
#
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json (ONLY for standalone scripts, never committed!)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
