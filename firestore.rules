rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Shared Authorization Helper Functions
    // -------------------------------------------------------------------------

    // Verifies the user has a valid authenticated session
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verifies caller matches the specified user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Cryptographic authority: role must be 'admin' in Custom Claims
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'Admin');
    }

    // Verifies user has an active status in Custom Claims
    function isActiveUser() {
      return isAuthenticated() &&
        (request.auth.token.status == 'active' || request.auth.token.status == 'Active');
    }

    // Validates string field presence and length bounds
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // -------------------------------------------------------------------------
    // Default Deny: All collections are closed unless explicitly matched
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // User Profiles: users/{userId}
    // -------------------------------------------------------------------------
    // Read:
    //   - Authenticated user can read their own profile.
    //   - Administrators can inspect all user profiles.
    // Create:
    //   - Only caller matching userId can create their profile.
    //   - Role can only be 'student' or 'faculty' (never 'admin').
    //   - Status must match role invariant ('Active' for student, 'Pending approval' for faculty).
    //   - Protected administrative fields cannot be injected.
    // Update:
    //   - Ordinary users can only modify non-privileged profile fields.
    //   - Role, status, approvedAt, approvedBy, uid, email, and createdAt are IMMUTABLE for users.
    //   - Administrators possess full profile update authority.
    // Delete:
    //   - Restricted exclusively to administrators.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['student', 'faculty']) &&
        (request.resource.data.role == 'student'
          ? request.resource.data.status == 'Active'
          : request.resource.data.status == 'Pending approval') &&
        !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'isAdmin', 'superAdmin']) &&
        isValidString(request.resource.data.fullName, 2, 100);

      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'status', 'approvedAt', 'approvedBy', 'uid', 'email', 'createdAt'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'avatarUrl', 'program', 'yearLevel', 'section', 'department', 'updatedAt'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName']) ||
          isValidString(request.resource.data.fullName, 2, 100)
        )
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Reports: reports/{reportId} (Listing Catalog & Report Lifecycle)
    // -------------------------------------------------------------------------
    // Read:
    //   - All authenticated users can browse and read listings.
    // Create:
    //   - Authenticated, active users only (suspended or pending approval users blocked).
    //   - Creator UID must match request.auth.uid (cannot spoof ownership).
    //   - Report type must be 'LOST' or 'FOUND'.
    //   - Initial status must be 'Active'.
    //   - Claims counter must initialize to 0.
    //   - Core fields validated for string presence and length boundaries.
    // Update:
    //   - Report owners may modify permitted content fields (title, category, location, etc.).
    //   - Immutables: reporterUid, type, ticketNumber, createdAt, claimsCount cannot be modified by user.
    //   - Owners can soft-close their report by updating status to 'Closed' or 'Withdrawn'.
    //   - Arbitrary status jumping is denied.
    //   - Administrators possess full update authority.
    // Delete:
    //   - Hard deletion is strictly restricted to administrators. Ordinary users soft-close.
    // -------------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && isActiveUser() &&
        request.resource.data.reporterUid == request.auth.uid &&
        (request.resource.data.type in ['LOST', 'FOUND', 'lost', 'found']) &&
        request.resource.data.status == 'Active' &&
        request.resource.data.claimsCount == 0 &&
        isValidString(request.resource.data.title, 2, 120) &&
        isValidString(request.resource.data.category, 2, 64) &&
        isValidString(request.resource.data.location, 2, 200) &&
        isValidString(request.resource.data.description, 5, 2000) &&
        isValidString(request.resource.data.date, 10, 10);

      allow update: if (
        isOwner(resource.data.reporterUid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reporterUid', 'type', 'ticketNumber', 'createdAt', 'claimsCount'
        ]) &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'category', 'date', 'location', 'description', 'imageUrl', 'imageStoragePath', 'updatedAt'
          ]) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'closedAt', 'closedBy', 'closeReason', 'updatedAt'
            ]) &&
            (request.resource.data.status in ['Closed', 'Withdrawn'])
          )
        )
      ) || isAdmin();

      allow delete: if isAdmin();

      // -----------------------------------------------------------------------
      // Claims subcollection: reports/{reportId}/claims/{claimId}
      // -----------------------------------------------------------------------
      // Read:
      //   - Claimant can read their own claim.
      //   - Parent report creator can read claims submitted on their listing.
      //   - Administrators possess full read authority.
      //   - Unrelated users are denied.
      // Create:
      //   - Authenticated, active user only.
      //   - Claimant UID must match request.auth.uid (cannot spoof claimant).
      //   - Cannot claim one's own report listing.
      //   - Initial status must be 'Pending'.
      //   - Parent report must not be 'Closed' or 'Resolved'.
      //   - Protected review fields cannot be injected.
      //   - String length bounds enforced.
      // Update:
      //   - Claimant can withdraw their pending claim (status -> 'Withdrawn').
      //   - Report owner can review pending claim (status -> 'Approved' or 'Declined').
      //   - Administrators possess full update authority.
      //   - Protected immutable fields (claimantUid, reportId, ticketId, mode, createdAt) cannot be modified.
      // Delete:
      //   - Restricted exclusively to administrators.
      // -----------------------------------------------------------------------
      match /claims/{claimId} {
        allow read: if isAuthenticated() && (
          isOwner(resource.data.claimantUid) ||
          isOwner(get(/databases/$(database)/documents/reports/$(reportId)).data.reporterUid) ||
          (resource.data.reportCreatorUid != null && isOwner(resource.data.reportCreatorUid)) ||
          isAdmin()
        );

        allow create: if isAuthenticated() && isActiveUser() &&
          request.resource.data.claimantUid == request.auth.uid &&
          request.resource.data.status == 'Pending' &&
          request.auth.uid != get(/databases/$(database)/documents/reports/$(reportId)).data.reporterUid &&
          (get(/databases/$(database)/documents/reports/$(reportId)).data.status in ['Active', 'Pending Claim', 'Pending Match']) &&
          !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'handoverLocation', 'resolvedClaimId']) &&
          isValidString(request.resource.data.proofDetails, 5, 2000) &&
          (request.resource.data.mode in ['claim', 'found_report']);

        allow update: if (
          // Case 1: Claimant withdrawing their own pending claim
          (
            isOwner(resource.data.claimantUid) &&
            resource.data.status == 'Pending' &&
            request.resource.data.status == 'Withdrawn' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'claimantUid', 'reportId', 'ticketId', 'mode', 'proofDetails', 'createdAt', 'reviewedBy', 'reviewedAt'
            ]) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'decisionReason', 'updatedAt'
            ])
          ) ||
          // Case 2: Parent report creator reviewing (approving or declining)
          (
            isOwner(get(/databases/$(database)/documents/reports/$(reportId)).data.reporterUid) &&
            resource.data.status == 'Pending' &&
            (request.resource.data.status in ['Approved', 'Declined']) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'claimantUid', 'reportId', 'ticketId', 'mode', 'proofDetails', 'createdAt'
            ]) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewedBy', 'reviewedAt', 'decisionReason', 'handoverLocation', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

        allow delete: if isAdmin();

        // Messages subcollection: Denied until Prompt 8
        match /messages/{messageId} {
          allow read, write: if false;
        }
      }
    }

    // -------------------------------------------------------------------------
    // Claims Collection Group: /{path=**}/claims/{claimId} (for My Claims feed)
    // -------------------------------------------------------------------------
    match /{path=**}/claims/{claimId} {
      allow read: if isAuthenticated() && (
        resource.data.claimantUid == request.auth.uid ||
        (resource.data.reportCreatorUid != null && resource.data.reportCreatorUid == request.auth.uid) ||
        isAdmin()
      );
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Taxonomies: Categories, academic programs, and departments
    // -------------------------------------------------------------------------
    // Read: Authenticated campus members.
    // Write: Administrators only.
    // -------------------------------------------------------------------------
    match /taxonomies/{taxonomyType}/items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Activity Logs: activity_logs/{logId} (System Audit Trail)
    // -------------------------------------------------------------------------
    // Read: Administrators only.
    // Write: Denied from client SDKs; written exclusively by trusted Admin SDK.
    // -------------------------------------------------------------------------
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Notifications: notifications/{notificationId}
    // -------------------------------------------------------------------------
    // Read: Targeted recipient only.
    // Update: Targeted recipient can only toggle the 'unread' boolean.
    // Create & Delete: Denied from client SDKs; managed via server-side triggers.
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread']);
      allow create, delete: if false;
    }
  }
}
