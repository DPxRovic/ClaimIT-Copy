rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for common authorization checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return isAuthenticated() &&
        (request.auth.token.status == 'active' || request.auth.token.status == 'Active');
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'Admin');
    }

    // Default deny: any collection not explicitly matched is closed
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: authenticated users can read their own profile; admins can read all profiles.
    // Client creation is permitted only for self-registration with non-admin roles and matching status.
    // Client updates are restricted to non-privileged fields (never role, status, approvedAt, uid, email).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['student', 'faculty']) &&
        (request.resource.data.role == 'student' ? request.resource.data.status == 'Active' : request.resource.data.status == 'Pending approval');
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'approvedAt', 'approvedBy', 'uid', 'email'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // Reports: Initial baseline placeholder for upcoming milestones.
    // Read: Authenticated users can browse listings.
    // Writes will be fully enabled in Report Milestone (Prompt 6).
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if false; // Denied until Prompt 6

      // Claims subcollection: Denied until Claim Milestone (Prompt 7)
      match /claims/{claimId} {
        allow read, write: if false;

        // Messages subcollection: Denied until Messaging Milestone (Prompt 8)
        match /messages/{messageId} {
          allow read, write: if false;
        }
      }
    }

    // Taxonomies: Categories, academic programs, and departments
    match /taxonomies/{taxonomyType}/items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Activity Logs: Read by administrators only; written exclusively via Admin SDK
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Notifications: Recipient can read and update (mark read) their own notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread']);
      allow create, delete: if false;
    }
  }
}
